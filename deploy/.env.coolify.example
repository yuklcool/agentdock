# Paste into Coolify's env UI (mark secrets as such). NEVER commit real values.
#
# Only the three REQUIRED values below must be filled in. Everything else has a
# default in deploy/docker-compose.coolify.yml, and secrets are generated by
# Coolify on the first deploy (SERVICE_REALBASE64_*, SERVICE_HEX_*,
# SERVICE_PASSWORD_*), then kept. Leave the commented lines commented unless you
# want to override: a placeholder value here would replace the generated secret.

# ============================== REQUIRED ==============================

# External / Coolify-managed Postgres. A plain `postgres://` URL (as Coolify hands
# out) is accepted. The control plane and connectors create their databases on
# first boot if missing. The database must share a network with this app.
DATABASE_URL=postgres://USER:PASSWORD@your-managed-db-host:5432/agentruntime

# Agent image version: <AGENT_REGISTRY>/agent-runtime:<AGENT_IMAGE_TAG>.
AGENT_IMAGE_TAG=0.3.10

# First admin login, created once on an empty database. The password is
# generated (read it from SERVICE_PASSWORD_ADMIN in Coolify) and must be changed
# at first sign-in.
SEED_STAFF_EMAIL=you@example.com

# ======================= Coolify / networking =========================

# Also set the domain on the `reverse-proxy` service (container port 80). Public
# URLs (connectors callbacks, console redirect) are derived from that domain.

# ========================= Optional overrides =========================

# --- Secrets (generated when unset; set only to reuse existing values) ---
# Changing either key after data exists makes stored credentials unreadable.
# CREDENTIAL_ENCRYPTION_KEY=   # base64 of 32 bytes: openssl rand -base64 32
# CONNECTORS_MASTER_KEY=       # base64 of 32 bytes: openssl rand -base64 32
# SEARXNG_SECRET=              # openssl rand -hex 32
# SEED_STAFF_PASSWORD=
# SEED_STAFF_NAME=Admin

# --- Agent image registry ---
# Defaults to the AgentDock GHCR packages. Private packages require the registry
# username and password below. Set an empty value to use only local images.
# AGENT_REGISTRY=ghcr.io/yuklcool/agentdock
# AGENT_REGISTRY_USERNAME=
# AGENT_REGISTRY_PASSWORD=
# Image pull policy at provision time: if-not-present (default) | always.
# AGENT_IMAGE_PULL_POLICY=if-not-present
# Pre-pull sweep interval for the default agent image (registry mode only).
# IMAGE_PREPULL_INTERVAL_SECONDS=600

# --- Per-agent caps, tiered by image variant ---
# `full` ships Chromium and needs more headroom than `slim`. Size the VM as
# base + N x the larger of the two.
# AGENT_MEM_LIMIT_FULL=2g
# AGENT_CPUS_FULL=1
# AGENT_MEM_LIMIT_SLIM=2g
# AGENT_CPUS_SLIM=1
# AGENT_MEM_LIMIT_MIN=256m
# AGENT_MEM_LIMIT_MAX=8g
# AGENT_CPUS_MIN=0.25
# AGENT_CPUS_MAX=4
# AGENT_PIDS_LIMIT=512

# --- Control plane ---
# Exa AI API key (https://exa.ai). When set, agents' web_search and web_read use
# Exa as the primary provider; unset = free SearXNG-only mode.
# EXA_API_KEY=
# Max total bytes moved between two workflow steps (default 500 MB).
# WORKFLOW_TRANSFER_MAX_BYTES=524288000
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# --- Connectors (blank provider creds disable that connector) ---
# CONNECTORS_PUBLIC_BASE_URL=https://agent.example.com/v1
# CONNECTORS_CONSOLE_REDIRECT_URL=https://agent.example.com/settings/connectors
# SLACK_SIGNING_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_OAUTH_SCOPES=app_mentions:read,chat:write
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_SLUG=

# --- Egress proxy ---
# EGRESS_DENYLIST=
# Chain agent egress through a rotating proxy (e.g. Webshare). Blank => direct.
# Set at most ONE of EXCLUDE (blacklist) / INCLUDE (whitelist).
# EGRESS_UPSTREAM_PROXY=http://user-rotate:pass@p.webshare.io:80
# EGRESS_UPSTREAM_EXCLUDE=api.anthropic.com,api.openai.com
# EGRESS_UPSTREAM_INCLUDE=
# Fall back to a direct dial if the upstream is down (leaks VM IP). Off by default.
# EGRESS_UPSTREAM_FALLBACK_DIRECT=true

# Optional administrator-only native network exceptions (space-separated CIDRs).
# Prefer exact MCP host IPs; shared with egress-proxy EGRESS_ALLOW_CIDRS.
# HTTP and HTTPS are both accepted; no AGENTDOCK_ALLOW_HTTP_MCP_SOURCE toggle is needed.
AGENTDOCK_NANOBOT_SSRF_WHITELIST=
